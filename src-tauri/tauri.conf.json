{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Deposit Ledger",
  "mainBinaryName": "The Deposit Ledger",
  "version": "0.1.5",
  "identifier": "org.tdl.ledger",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Deposit Ledger",
        "width": 1440,
        "height": 1024,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ledger"
    ],
    "macOS": {
      "entitlements": "../entitlements.plist"
    }
  }
}
